@implements IAsyncDisposable
@inject IJSRuntime Js

@* Shell of the pages before a game and the other menu pages (setup, Saved Games, Help, Endings Gallery), in the look of the
   Unity setup views: dark metal (Main_BG) with a warm glow and embers, the steel frame (MFW_Border_1) fixed to the
   window, the round back button top left and an Evil Dead title. The page content styles are in css/menu-pages.css. *@
<div class="menu-page-scene" aria-hidden="true">
    <div class="menu-page-bg"></div>
    <div class="menu-page-light"></div>
    <canvas id="@_FxId" class="menu-page-fx"></canvas>
    <div class="menu-page-vignette"></div>
</div>
<div class="menu-page-frame" aria-hidden="true"></div>

@if (OnBack.HasDelegate)
{
    string back = GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Back);
    <button class="icon-button menu-page-back" @onclick="OnBack" aria-label="@back" title="@back"></button>
}

<main class="menu-page @Class">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h1 class="menu-page-title">@Title</h1>
    }
    @ChildContent
</main>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    // One canvas id per page, so the next page's start never races this page's stop
    private static int _Count;
    private readonly string _FxId = $"menu-page-fx-{++_Count}";

    [Parameter] public string?         Title        { get; set; }
    [Parameter] public string          Class        { get; set; } = string.Empty;
    [Parameter] public EventCallback   OnBack       { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Js.InvokeVoidAsync("mfwAtmosphere.start", _FxId, new object[] { new { kind = "ember", count = 30 }, new { kind = "smoke", count = 3 } });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("mfwAtmosphere.stop", _FxId);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
