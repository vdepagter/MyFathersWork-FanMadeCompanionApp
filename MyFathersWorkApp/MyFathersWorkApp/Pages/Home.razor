@page "/"
@implements IAsyncDisposable
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject IJSRuntime        Js
@inject HttpClient        Http
@inject AudioService      Audio
@inject SavedGamesService SavedGames

<PageTitle>My Father's Work Companion App</PageTitle>

@* Main Menu from the Unity app (Scenes/Main.unity, canvas 1920 x 1082). The art fills the window (cover) and the menu
   fits inside it (contain), so the layers never slide against each other. Positions are the Unity RectTransforms;
   the canvases are filled by js/atmosphere.js. *@
<div class="menu-art" aria-hidden="true">
    @foreach (Layer layer in _BackLayers)
    {
        <img class="layer @layer.Css" src="images/ui/@(layer.Image).webp" alt="" style="@layer.Style"/>
    }
    <canvas class="fx" id="menu-fx-back"></canvas>
    @foreach (Layer layer in _FrontLayers)
    {
        <img class="layer @layer.Css" src="images/ui/@(layer.Image).webp" alt="" style="@layer.Style"/>
    }
    @foreach (Layer light in _VillageLights)
    {
        <div class="layer village-light" style="@light.Style"></div>
    }
    <canvas class="fx" id="menu-fx-front"></canvas>
    <div class="layer vignette"></div>
    <div class="layer blue-light" style="@_BlueLight.Style"></div>
    <div class="layer lightning" id="menu-lightning"></div>
</div>
<div class="menu-frame" aria-hidden="true"></div>

<div class="menu">
    <button class="help-button" @onclick="OpenHelp" aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Help)"
            title="@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Help)"></button>

    <img class="menu-logo" src="images/ui/logo.webp" alt="My Father's Work">

    <div class="menu-buttons">
        <button class="mfw-button" disabled="@(!IsContinueAvailable)" @onclick="OnContinue">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Continue)</button>
        <button class="mfw-button" @onclick="OnNewGameClick">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_NewGame)</button>
        <button class="mfw-button" @onclick="OpenSavedGames">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_SavedGames)</button>
        <button class="mfw-button" @onclick="ShowLoadPopup">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_LoadGame)</button>
        <button class="mfw-button" @onclick="ShowSettings">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Settings)</button>
        <button class="mfw-button" @onclick="OpenGallery">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Endings)</button>
    </div>

    <p class="disclaimer">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_FanMade)</p>
</div>

<LoadGamePopup Visible="@_ShowLoadGame" OnBack="HideLoadPopup" GlobalData="@GlobalData"/>
<SettingsPopup Visible="@_ShowSettings" OnClose="HideSettings" OnLanguageChange="OnLanguageChanges" GlobalData="@GlobalData"/>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private bool IsContinueAvailable { get; set; }
    
    private bool _ShowLoadGame;
    private bool _ShowSettings;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        IsContinueAvailable = await GlobalData.IsContinueAvailableAsync(Js);
    }

    // A picture placed like a Unity RectTransform on the 1920 x 1082 canvas: left and top edge, width, height (canvas units)
    private sealed record Layer(string Image, double X, double Top, double W, double H, string Css = "")
    {
        private static string P(double value, double of) => (value / of * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
        public string Style => $"left:{P(X, 1920)}; top:{P(Top, 1082)}; width:{P(W, 1920)}; height:{P(H, 1082)}";
    }

    // Unity draws the square tree and manor sprites with "preserve aspect" (Trees-1 is 1:2, so half as wide as its rect)
    private static readonly Layer[] _BackLayers =
    [
        new("menu-sky", 0, 0, 1920, 1082),
        new("menu-mountain", 0, 0, 1920, 1082),
        new("menu-village", 0, 0, 1920, 1080)
    ];

    private static readonly Layer[] _FrontLayers =
    [
        new("menu-trees-1", 1096, 568, 256, 512, "tree"),
        new("menu-manor", -137, -112, 1364, 1364),
        new("menu-tree-3", 94, 758, 220, 219, "tree"),
        new("menu-tree-3", 531, 877, 173, 173, "tree"),
        new("menu-trees-1", 398, 558, 256, 512, "tree"),
        new("menu-tree-4", -29, 611, 512, 512, "tree"),
        new("menu-tree-3", 254, 750, 300, 300, "tree"),
        new("menu-tree-3", 77, 587, 512, 512, "tree"),
        new("menu-trees-1", 985, 577, 256, 512, "tree"),
        new("menu-tree-3", 704, 591, 512, 512, "tree")
    ];

    // Orange "FakeLight" glows over the village windows, and the large blue one that lights the whole scene
    private static readonly Layer[] _VillageLights =
    [
        new("", 1688, 915, 108, 109), new("", 1494, 962, 108, 108), new("", 1534, 935, 108, 108), new("", 1619, 935, 109, 108)
    ];

    private static readonly Layer _BlueLight = new("", -216, -684, 2352, 1530);

    // Particle counts at High quality (Medium draws ~40%, Low none)
    private static readonly object[] _BackFx  = [new { kind = "rainBack", count = 120 }, new { kind = "fog", count = 10 }];
    private static readonly object[] _FrontFx = [new { kind = "rainFront", count = 170 }, new { kind = "ember", count = 28 }, new { kind = "smoke", count = 8 }];

    private static readonly string[] _FxIds = ["menu-fx-back", "menu-fx-front", "menu-lightning"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Audio.PlayWelcomeOnce();
        await Js.InvokeVoidAsync("mfwAtmosphere.start", "menu-fx-back", _BackFx);
        await Js.InvokeVoidAsync("mfwAtmosphere.start", "menu-fx-front", _FrontFx);
        await Js.InvokeVoidAsync("mfwAtmosphere.lightning", "menu-lightning");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            foreach (string id in _FxIds) await Js.InvokeVoidAsync("mfwAtmosphere.stop", id);
        }
        catch (JSDisconnectedException) { }
    }

    private void ShowLoadPopup()
    {
        Audio.PlayClick();
        _ShowLoadGame = true;
    }

    private void HideLoadPopup() => _ShowLoadGame = false;

    private void ShowSettings()
    {
        Audio.PlayClick();
        _ShowSettings = true;
    }

    private void HideSettings() => _ShowSettings = false;

    private void OpenSavedGames()
    {
        Audio.PlayClick();
        Nav.NavigateTo("SavedGames");
    }

    private void OpenGallery()
    {
        Audio.PlayClick();
        Nav.NavigateTo("EndingsGallery");
    }

    private void OpenHelp()
    {
        Audio.PlayClick();
        Nav.NavigateTo("Help");
    }

    private async Task OnNewGameClick()
    {
        Audio.PlayClick();
        Audio.Play(SoundCue.Footsteps);
        await SavedGames.ArchiveCurrentAsync();
        await GlobalData.ClearSavedGameAsync(Js);
        GlobalData.ScenarioId  = ScenarioId.None;
        GlobalData.PlayersNum  = 0;
        GlobalData.PlayerAName = string.Empty;
        GlobalData.PlayerBName = string.Empty;
        GlobalData.PlayerCName = string.Empty;
        GlobalData.PlayerDName = string.Empty;
        GlobalData.TownName    = string.Empty;
        Nav.NavigateTo("PlayersSelect");
    }

    private async void OnContinue()
    {
        Audio.PlayClick();
        await GlobalData.LoadGameAsync(string.Empty, Nav, Http, Js);
        Nav.NavigateTo("Gameplay");
    }

    private void OnLanguageChanges(string language)
    {
        GlobalData.Language = language;
        Nav.NavigateTo("");
    }
}
