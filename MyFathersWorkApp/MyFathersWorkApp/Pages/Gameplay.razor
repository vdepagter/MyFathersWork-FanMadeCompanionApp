@page "/Gameplay"
@using MyFathersWorkApp.Shared
@inject IJSRuntime        Js
@inject NavigationManager Nav
@inject HttpClient        Http
@inject AudioService      Audio
@inject GalleryService    Gallery
@inject LogBookService    LogBook
@implements IDisposable

@* Unity GanrationEnding (story) / GanrationHUb (round) views: the scenario illustration or dark metal background with
   its lights, embers on the round pages, the frame and the round bar in the frame (images/ui, HANDOFF.md "Visual overhaul") *@
<div class="game-scene @SceneClass" aria-hidden="true">
    <div class="scene-bg"></div>
    <div class="scene-light"></div>
    <canvas id="game-fx" class="scene-fx"></canvas>
    <div class="scene-vignette"></div>
</div>
<div class="game-frame @SceneClass" aria-hidden="true"></div>

<div class="header-buttons" xmlns="http://www.w3.org/1999/html">
    <button class="icon-button back-button" disabled="@GlobalData.IsUndoDisabled" @onclick="GoBack"
            aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Undo)"
            title="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Undo)"></button>
    <button class="icon-button forward-button" disabled="@GlobalData.IsRedoDisabled" @onclick="GoForward"
            aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Redo)"
            title="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Redo)"></button>
    <button class="icon-button pause-button" @onclick="Pause"
            aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_PauseMenu)"
            title="@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_PauseMenu)"></button>
    @if (LogBookService.HasLogBook(GlobalData))
    {
        <button class="icon-button logbook-open-button"
                aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Open)"
                title="@GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Open)"
                @onclick="OpenLogBook"></button>
    }
</div>

<SaveNotification Visible="@_ShowSaveNotification" GlobalData="GlobalData"/>

@* Round and Generation, in the slot of the frame (Unity Progress: MFW_ProgressBar behind the frame's nine windows) *@
<div class="round-tracker @SceneClass" role="list">
    <div class="round-bar"></div>
    @for (int i = 0; i < _RoundLabels.Length; i++)
    {
        string state = i < CurrentRoundIndex ? "past" : i == CurrentRoundIndex ? "current" : "future";

        <div class="round-step @state" role="listitem" style="@_RoundCells[i]"
             aria-current="@(i == CurrentRoundIndex ? "step" : null)">@_RoundLabels[i]</div>
    }
    <div class="round-tray"></div>
</div>

@if (GlobalData.ActiveMirrorQuestion != null)
{
    <MirrorPopup @key="GlobalData.ActiveMirrorQuestion" GlobalData=@GlobalData Question=@GlobalData.ActiveMirrorQuestion Refresh=Refresh/>
}

<div class="gameplay-container">

    @if (GlobalData.ActiveMirrorQuestion == null && GlobalData.ActivePopup == null && GlobalData.ActiveInputPopup == null && GlobalData.ActiveWindow != null)
    {
        _SaveGame = true;
        <h1>@GlobalData.ActiveWindow.Title.InsertImages().ProtectNames(GlobalData).AsMarkup()</h1>

        @if (GlobalData.ActiveWindow.Subtitle != string.Empty)
        {
            <h2>@GlobalData.ActiveWindow.Subtitle.InsertImages().ProtectNames(GlobalData).AsMarkup()</h2>
        }

        @if (HasNarration(GlobalData.ActiveWindow))
        {
            // Voice-over indicator, only on narrated windows (docs/AUDIO_TRANSITIONS_MAP.md "Voice-over")
            bool          narrationOff = Audio.Narration == NarrationVoice.Off;
            VoicePillState pillState    = VoicePillFor(GlobalData.ActiveWindow);

            <div class="narration-pill">
                <span>🎙 @GlobalData.GetLocalizedUITag(narrationOff ? GlobalTags.Narration_Available : GlobalTags.Narration_Narrated)</span>
                @switch (pillState)
                {
                    case VoicePillState.Starting:
                        <span>@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Starting)</span>
                        break;
                    case VoicePillState.Speaking:
                        <span class="narration-bars" aria-hidden="true"><i></i><i></i><i></i></span>
                        @* Progress, seeking and the 10 s jumps are handled in js/audio.js (no round trip per frame) *@
                        <button class="narration-button" data-voice-skip="-10"
                                aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Back)"
                                title="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Back)">⟲</button>
                        <div class="narration-progress" role="slider" tabindex="0" aria-valuemin="0" aria-valuemax="100"
                             aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Position)"><i></i></div>
                        <button class="narration-button" data-voice-skip="10"
                                aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Forward)"
                                title="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Forward)">⟳</button>
                        <span class="narration-time"></span>
                        <button class="narration-button"
                                aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Stop)"
                                title="@GlobalData.GetLocalizedUITag(GlobalTags.Narration_Stop)"
                                @onclick="OnStopVoiceClicked">■</button>
                        break;
                    default:
                        string playLabel = pillState == VoicePillState.Replay && !narrationOff
                                               ? "↻ " + GlobalData.GetLocalizedUITag(GlobalTags.Narration_Replay)
                                               : "▶ " + GlobalData.GetLocalizedUITag(GlobalTags.Narration_Play);
                        <button class="narration-button" @onclick="OnPlayVoiceClicked">@playLabel</button>
                        break;
                }
            </div>
        }

        <div class="parchment-box">
            @{
                // A vote or bid special event without its own "start the vote" link gets a Start button above its links
                bool? revealKind   = RevealKind(GlobalData.ActiveWindow);
                bool  revealButton = revealKind != null && !GlobalData.ActiveWindow.Elements.Any(IsRevealLink);
            }
            @foreach (GameplayElement element in GlobalData.ActiveWindow.Elements)
            {
                if (revealButton && element.Callback != null)
                {
                    revealButton = false;
                    bool bid = revealKind == true;
                    <div class="reveal-start">
                        <button class="mfw-button green" @onclick="() => OpenReveal(bid, null)">
                            @GlobalData.GetLocalizedUITag(bid ? GlobalTags.Reveal_StartBid : GlobalTags.Reveal_StartVote)
                        </button>
                    </div>
                }

                if (element.FromNewLine)
                {
                    <br/>
                    <br/>
                }

                if (element.Callback == null)
                {
                    @element.Content.InsertImages().ProtectNames(GlobalData).AsMarkup()
                }
                else
                {
                    <a class="story-link" @onclick="() => OnWindowLinkClicked(element)">[@LinkText(element.Content)]</a>
                }
            }
        </div>

        @if (GlobalData.ActiveWindow.IsFinalEnding && _GalleryCard != null && ReferenceEquals(_GalleryNoted, GlobalData.ActiveWindow))
        {
            // After THE END?: Next opens the ending page (Unity ViewEndingPage)
            <button class="mfw-button green ending-next" @onclick="ShowEndingPage">@GlobalData.GetLocalizedUITag(GlobalTags.Ending_Next)</button>
        }
    }
    else if (GlobalData.ActiveMirrorQuestion == null && GlobalData.ActivePopup == null && GlobalData.ActiveInputPopup == null && GlobalData.ActiveHub != null)
    {
        if (_SaveGame)
        {
            GlobalData.TmpValues.Clear();
            SaveGameAsync();
            _SaveGame = false;
        }

        <h1>@GlobalData.ActiveHub.Title.InsertImages().ProtectNames(GlobalData).AsMarkup()</h1>

        @if (GlobalData.ActiveHub.Subtitle != string.Empty)
        {
            <h2>@GlobalData.ActiveHub.Subtitle.InsertImages().ProtectNames(GlobalData).AsMarkup()</h2>
        }

        @if (GlobalData.SecretPagesShown)
        {
            <p class="storybook-shared">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_StorybookShared)</p>
        }

        foreach (GameplayHubSection hubSection in GlobalData.ActiveHub.Sections)
        {
            @if (hubSection.ShouldShow())
            {
                <div class="@(hubSection.Main ? "main-panel" : "section-panel")">
                    @if (hubSection.Main)
                    {
                        <h3>@hubSection.Title.InsertImages().ProtectNames(GlobalData).AsMarkup()</h3>
                    }
                    else
                    {
                        <h4>@hubSection.Title.InsertImages().ProtectNames(GlobalData).AsMarkup()</h4>
                    }

                    @foreach (GameplayElement element in hubSection.Elements)
                    {
                        if (element.FromNewLine)
                        {
                            <br/>
                            <br/>
                        }

                        if (element.Callback == null)
                        {
                            @element.Content.InsertImages().ProtectNames(GlobalData).AsMarkup()
                        }
                        else
                        {
                            <a class="gameplay-link"
                               @onclick="() => InvokeWindowCallback(element.Callback)">[@LinkText(element.Content)]</a>
                        }
                    }
                </div>
            }
        }
    }

</div>

@if (GlobalData.ActivePopup != null && GlobalData.ActiveMirrorQuestion == null)
{
    _SaveGame = true;
    <InfoPopup GlobalData=@GlobalData GameplayPopUp=@GlobalData.ActivePopup Refresh=Refresh/>
}

@if (GlobalData.ActiveInputPopup != null && GlobalData.ActiveMirrorQuestion == null)
{
    _SaveGame = true;
    <InputPopup @key="GlobalData.ActiveInputPopup" GlobalData=@GlobalData GameplayPopUp=@GlobalData.ActiveInputPopup Refresh=Refresh/>
}

@if (_ShowEndingPage && _GalleryCard != null)
{
    // What the Endings Gallery recorded for this playthrough (Shared/Gallery.cs); closing goes to the Main Menu
    <div class="ending-page" role="dialog" aria-labelledby="ending-page-title">
        <div class="ending-panel mfw-dark-panel mfw-zoom-in @(_GalleryCard.NewEnding ? "new" : "")">
            <div class="ending-star" aria-hidden="true">★</div>
            <h2 id="ending-page-title" class="mfw-heading">
                @GlobalData.GetLocalizedUITag(_GalleryCard.NewEnding ? GlobalTags.Ending_Unlocked : GlobalTags.Ending_Recorded)
            </h2>
            <p class="ending-name">@_GalleryCard.EndingTitle.InsertImages().ProtectNames(GlobalData).AsMarkup()</p>
            <p class="ending-count">@GlobalData.GetLocalizedUITag(GlobalTags.Ending_UnlockedCount).FormatWithReplacement(0, _GalleryCard.Done.ToString())</p>
            <div class="ending-slots" aria-hidden="true">
                @for (int i = 0; i < 8; i++)
                {
                    <span class="@(i < _GalleryCard.Done ? "done" : "")"></span>
                }
            </div>
            <p>@_GalleryCard.WinLine</p>
            <p class="ending-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_RecordedNote)</p>
            <div class="ending-buttons">
                <button class="mfw-button" @onclick="OpenGallery">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Endings)</button>
                <button class="mfw-button green" @onclick="GoToMainMenu">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_ReturnToMainMenu)</button>
            </div>
            <button class="ending-close" aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.Settings_Close)" @onclick="CloseEndingPage">✕</button>
        </div>
    </div>
}

<RevealPanel Visible="@_ShowReveal" Bid="@_RevealBid" GlobalData="@GlobalData" OnAccept="AcceptReveal" OnCancel="CancelReveal"/>

@if (_BannerKey > 0)
{
    // Unity ViewSpecialEvent: "SPECIAL EVENT" fades in and out over the new special event window (4.5 s)
    <div class="special-event-banner" @key="_BannerKey" role="img" aria-label="@GlobalData.GetLocalizedUITag(GlobalTags.SpecialEvent_Title)">
        <i class="se-line"></i>
        <div class="se-text"></div>
        <i class="se-line right"></i>
    </div>
}

<PauseMenu 
    Visible="@_ShowPauseMenu"
    OnResume="HidePauseMenu"
    OnShowSavePopup="TriggerSavePopup"
    GlobalData="@GlobalData"
    IsThereAnySavedState="@_IsThereAnySavedState"/>

<LogBookPopup
    Visible="@_ShowLogBook"
    Entries="@_LogBookEntries"
    GlobalData="@GlobalData"
    OnClose="CloseLogBook"/>

<SavePopup 
    Visible="@_ShowSavePopup" 
    Base64Save="@_Base64EncodedGame" 
    OnBack="HideSavePopup"
    GlobalData="@GlobalData"/>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private bool   _SaveGame;
    private bool   _ShowSaveNotification;
    private bool   _ShowPauseMenu;
    private bool   _IsThereAnySavedState;
    private bool   _ShowSavePopup;
    private string _Base64EncodedGame = string.Empty;

    private readonly string[] _RoundLabels =
    [
        "I - 1", "I - 2", "I - 3",
        "II - 1", "II - 2", "II - 3",
        "III - 1", "III - 2", "III - 3"
    ];

    private int CurrentRoundIndex => (int)GlobalData.Generation * 3 + (int)GlobalData.Years;

    // The nine windows of the frame's round slot, as left / width in % of images/ui/round-tray-*.webp (1200 px wide)
    private static readonly string[] _RoundCells =
        new (int X0, int X1)[] { (74, 187), (194, 304), (311, 418), (431, 537), (545, 654), (662, 766), (780, 887), (894, 1004), (1011, 1123) }
           .Select(c => FormattableString.Invariant($"left: {c.X0 / 12.0:0.##}%; width: {(c.X1 - c.X0 + 1) / 12.0:0.##}%")).ToArray();

    // Story window (or a popup over one, or nothing yet): the scenario illustration with the gold frame; the round hub
    // (or a popup over it): dark metal with embers
    private bool IsHubScene => GlobalData.ActiveWindow == null && GlobalData.ActiveHub != null;

    private string SceneClass => IsHubScene
        ? "hub"
        : "story " + GlobalData.ScenarioId switch
        {
            ScenarioId.FearOfUnknown => "fotu",
            ScenarioId.TimeOfWar     => "atow",
            _                        => "cod"
        };

    // The narration toggle (Shared/AudioToggles.razor) changed the voice: redraw the narration pill
    private void OnNarrationSettingChanged() => InvokeAsync(StateHasChanged);

    // Embers rise on the round pages only (js/atmosphere.js; Graphics Low draws none)
    private bool? _EmbersOn;

    private void UpdateEmbers()
    {
        bool on = IsHubScene;
        if (_EmbersOn == on) return;
        _EmbersOn = on;
        if (on) _ = Js.InvokeVoidAsync("mfwAtmosphere.start", "game-fx", new object[] { new { kind = "ember", count = 50 }, new { kind = "smoke", count = 5 } });
        else _ = Js.InvokeVoidAsync("mfwAtmosphere.stop", "game-fx");
    }

    // Link labels are plain text (often a player name): encode, then mark the names translate="no"
    private MarkupString LinkText(string content) => System.Net.WebUtility.HtmlEncode(content).ProtectNames(GlobalData).AsMarkup();

    private void HidePauseMenu()
    {
        _ShowPauseMenu = false;
        Audio.VoiceResume(); // Unity: the pause popup's confirm button resumes the voice-over (SoundManager.OnVOResume)
    }
    
    protected override async Task OnInitializedAsync()
    {
        _VoiceListener = DotNetObjectReference.Create(this);
        Audio.NarrationChanged += OnNarrationSettingChanged;
        Audio.VoiceSubscribe(_VoiceListener);

        await base.OnInitializedAsync();

        if (GlobalData.ActiveHub == null && GlobalData.ActiveWindow == null && GlobalData.ActivePopup == null && GlobalData.ActiveInputPopup == null)
        {
            await GlobalData.LoadGameAsync(string.Empty, Nav, Http, Js);
        }

        await LogBook.LoadAsync(GlobalData.ScenarioId);

        _Initialized = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_Initialized) return;

        ScreenChangeInfo info = DetectScreenChange();
        PlayScreenSounds(info);
        UpdateVoiceOver(info);
        PlayScreenTransition(info);
        ShowSpecialEventBanner(info);
        ScrollToTop(info);
        UpdateEmbers();
        UpdateMusic();
        _ = GlobalData.PersistAsync(Js); // the game and its undo history, after every screen and every undo
        _ = NoteGalleryAsync();
        LogBook.Note(GlobalData);
    }

    #region Log Book (Shared/LogBook.cs)

    private bool               _ShowLogBook;
    private List<LogBookEntry> _LogBookEntries = [];

    private void OpenLogBook()
    {
        Audio.PlayClick();
        _LogBookEntries = LogBook.Entries(GlobalData);
        _ShowLogBook    = true;
    }

    private void CloseLogBook()
    {
        _ShowLogBook = false;
    }

    #endregion Log Book

    #region Endings Gallery

    private record GalleryCard(bool NewEnding, string Progress, string WinLine, int Done, string EndingTitle);

    private bool _ShowEndingPage;

    private void ShowEndingPage()
    {
        Audio.PlayClick();
        _ShowEndingPage = true;
    }

    private void CloseEndingPage()
    {
        Audio.PlayClick();
        _ShowEndingPage = false;
    }

    private void GoToMainMenu()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }

    private object?      _GalleryNoted; // the hub or final ending window last passed to the gallery
    private GalleryCard? _GalleryCard;

    // Remembers players and branches on every hub, and records the playthrough when its final ending is shown. Undo and
    // load show the ending again with a new window object, which replaces the record (keyed by FlavorSeed).
    private async Task NoteGalleryAsync()
    {
        if (GlobalData.ActiveMirrorQuestion != null || GlobalData.ActivePopup != null || GlobalData.ActiveInputPopup != null) return;

        try
        {
            // Ending 0: no ending was decided (only seen with crafted saves), nothing to record
            if (GlobalData.ActiveWindow is { IsFinalEnding: true } window && GalleryTrees.Ending(GlobalData) > 0)
            {
                if (ReferenceEquals(_GalleryNoted, window)) return;
                _GalleryNoted = window;

                (GalleryGame game, bool newEnding) = await Gallery.RecordGameAsync(GlobalData, window.Title);
                GalleryData data = await Gallery.GetAsync();
                int         wins = data.Games.Count(other => !other.FamilyWinner && other.Winner == game.Winner);

                int done = GalleryService.EndingsDone(data, game.Scenario).Count;
                _ShowEndingPage = false;
                _GalleryCard = new GalleryCard(newEnding,
                                               GlobalData.GetLocalizedUITag(GlobalTags.Gallery_ScenarioProgress)
                                                         .FormatWithReplacement(0, GalleryTrees.Name(game.Scenario))
                                                         .FormatWithReplacement(1, done.ToString()),
                                               game.FamilyWinner
                                                   ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_FamilyWin)
                                                   : GlobalData.GetLocalizedUITag(GlobalTags.Gallery_WinFor)
                                                               .FormatWithReplacement(0, game.Winner)
                                                               .FormatWithReplacement(1, wins.ToString()),
                                               done,
                                               window.Title);
                StateHasChanged();
            }
            else if (GlobalData.ActiveWindow == null && GlobalData.ActiveHub != null)
            {
                if (ReferenceEquals(_GalleryNoted, GlobalData.ActiveHub)) return;
                _GalleryNoted = GlobalData.ActiveHub;
                await Gallery.NoteHubAsync(GlobalData);
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Gallery: {e.Message}");
        }
    }

    private void OpenGallery()
    {
        Audio.PlayClick();
        Nav.NavigateTo("EndingsGallery");
    }

    #endregion Endings Gallery

    #region Screen change detection (audio and screen transitions)

    // What changed on screen since the last detection:
    //   BaseKind   - the base screen switched between a story window and a hub (popups in between do not count)
    //   SameKind   - a new window replaced a window, or the hub was rebuilt
    //   Popup      - a new GameplayPopup (setup, end of round, end of generation) is shown
    //   InputPopup - a new GameplayInputPopup is shown
    // Suppressed: the change comes from undo (GoBack) or from the first screen of this page (arrival after start, load
    // or reload), so it should be shown without sound or transition.
    public enum ScreenChange { None, BaseKind, SameKind, Popup, InputPopup }

    public readonly record struct ScreenChangeInfo(ScreenChange Change, bool Suppressed, object? Presented);

    private enum BaseScreenKind { None, Window, Hub }

    private bool           _Initialized;
    private bool           _SuppressScreenChange = true; // the first screen of the page is never announced
    private object?        _LastPresented;
    private BaseScreenKind _LastBaseKind;

    // Compares the presented object (popup > input popup > window > hub, as rendered above) with the last one. While a
    // mirror question is open nothing is recorded: the question is answered by a rerun whose result is compared with
    // the screen the question was asked from. Screen models are rebuilt on every action, so references tell new screens apart.
    private ScreenChangeInfo DetectScreenChange()
    {
        if (GlobalData.ActiveMirrorQuestion != null) return new ScreenChangeInfo(ScreenChange.None, _SuppressScreenChange, null);

        object? presented = (object?)GlobalData.ActivePopup ?? (object?)GlobalData.ActiveInputPopup ?? (object?)GlobalData.ActiveWindow ?? GlobalData.ActiveHub;
        if (presented == null) return new ScreenChangeInfo(ScreenChange.None, _SuppressScreenChange, null);

        bool suppressed = _SuppressScreenChange;
        _SuppressScreenChange = false;

        if (suppressed && _LastBaseKind == BaseScreenKind.None)
        {
            // First screen: remember the base screen under a popup too, so closing that popup is not a base change
            _LastBaseKind = GlobalData.ActiveWindow != null ? BaseScreenKind.Window : GlobalData.ActiveHub != null ? BaseScreenKind.Hub : BaseScreenKind.None;
        }

        if (ReferenceEquals(presented, _LastPresented)) return new ScreenChangeInfo(ScreenChange.None, suppressed, presented);
        _LastPresented = presented;

        ScreenChange change;

        switch (presented)
        {
            case GameplayPopup:
                change = ScreenChange.Popup;
                break;
            case GameplayInputPopup:
                change = ScreenChange.InputPopup;
                break;
            default:
            {
                BaseScreenKind kind = presented is GameplayWindow ? BaseScreenKind.Window : BaseScreenKind.Hub;
                change        = _LastBaseKind != BaseScreenKind.None && kind != _LastBaseKind ? ScreenChange.BaseKind : ScreenChange.SameKind;
                _LastBaseKind = kind;
                break;
            }
        }

        return new ScreenChangeInfo(change, suppressed, presented);
    }

    private void PlayScreenSounds(ScreenChangeInfo info)
    {
        if (info.Suppressed || info.Change == ScreenChange.None) return;

        switch (info.Change)
        {
            case ScreenChange.BaseKind:
                Audio.Play(SoundCue.TransitionCover);
                Audio.Play(SoundCue.TransitionReveal, _REVEAL_DELAY_MS);
                break;
            case ScreenChange.Popup when info.Presented is GameplayPopup popup:
                Audio.Play(SoundCue.TransitionReveal);
                Audio.Play(popup.PopUpTitle is PopUpTitle.EndOfRound or PopUpTitle.EndOfGeneration ? SoundCue.EndOfRound : SoundCue.Setup);
                break;
        }

        if (info.Presented is GameplayWindow { Cue: not SoundCue.None } window) Audio.Play(window.Cue);
    }

    // Delay of the reveal sound after the cover sound on a base change: the ink overlay covers the screen this long before it
    // recedes. Must match the hold in wwwroot/js/transitions.js / the mfw-ink-base keyframes in wwwroot/css/styles.css.
    private const int _REVEAL_DELAY_MS = 200;

    // CSS screen transitions (wwwroot/js/transitions.js): the ink overlay for a base change or a new setup / end of round
    // popup, and entrance animations of the new screen. Undo, the first screen and mirror questions show no transition.
    // Runs before the browser paints the new screen, so the overlay covers it from the first frame.
    private void PlayScreenTransition(ScreenChangeInfo info)
    {
        if (info.Suppressed) return;

        switch (info.Change)
        {
            case ScreenChange.BaseKind:
                _ = Js.InvokeVoidAsync("mfwTransitions.run", "base");
                if (info.Presented is GameplayWindow) _ = Js.InvokeVoidAsync("mfwTransitions.enter", "rise");
                break;
            case ScreenChange.SameKind:
                // A new story page rises from the bottom (Unity), a rebuilt hub fades
                _ = Js.InvokeVoidAsync("mfwTransitions.enter", info.Presented is GameplayWindow ? "rise" : "same");
                break;
            case ScreenChange.Popup:
                _ = Js.InvokeVoidAsync("mfwTransitions.run", "popup");
                _ = Js.InvokeVoidAsync("mfwTransitions.enter", "popup");
                break;
            case ScreenChange.InputPopup:
                _ = Js.InvokeVoidAsync("mfwTransitions.enter", "input");
                break;
        }
    }

    // A new story window, or a hub reached from a window or in a new round, starts at the top of the page. A hub rebuilt
    // in the same round (after a hub link's popup) goes back to where the link was clicked, so players don't lose their
    // place (the hub is not rendered under a popup, so the browser cut the scroll position back).
    private int _LastHubRound = -1;

    private void ScrollToTop(ScreenChangeInfo info)
    {
        if (info.Change is not (ScreenChange.BaseKind or ScreenChange.SameKind)) return;

        if (info.Presented is GameplayHub)
        {
            if (info.Change == ScreenChange.SameKind && _LastHubRound == CurrentRoundIndex)
            {
                _ = Js.InvokeVoidAsync("mfwTransitions.restoreScroll");
                return;
            }

            _LastHubRound = CurrentRoundIndex;
        }

        _ = Js.InvokeVoidAsync("mfwTransitions.scrollTop");
    }

    // Scenario theme, or the end-game track while the final ending is shown. Idempotent (AudioService and audio.js only
    // switch when the track differs), so re-renders, undo and load never restart the music.
    private void UpdateMusic()
    {
        if (GlobalData.ActiveHub == null && GlobalData.ActiveWindow == null && GlobalData.ActivePopup == null && GlobalData.ActiveInputPopup == null) return;
        Audio.SetMusic(GlobalData.ActiveWindow?.IsFinalEnding == true ? MusicTrack.Ending : AudioService.ScenarioTheme(GlobalData.ScenarioId));
    }

    #endregion

    #region Voice-over (docs/AUDIO_TRANSITIONS_MAP.md "Voice-over")

    // A narrated window (GameplayWindow.VoiceOver, or Oliver clips - Shared/Narration.cs) that is newly presented by a
    // click starts the narration: thunder lead-in, then the clip (audio.js); Oliver clips play without the lead-in, and
    // never by themselves in a private section (one player reads alone: Play only). Undo, load and reload (Suppressed) never start it, nor does a window shown before
    // the first user gesture (the browser would block it); the indicator then offers Play. Anything else on screen - a
    // popup, another window, the hub, a mirror question - stops it, as Unity stops it on every passage change. Undo,
    // leaving the page and a change of the narration setting stop it too.
    private enum VoiceState { Idle, Starting, Speaking }

    private enum VoicePillState { Play, Replay, Starting, Speaking }

    private DotNetObjectReference<Gameplay>? _VoiceListener;
    private GameplayWindow?                  _VoiceWindow;  // the narrated window the state below belongs to
    private VoiceState                       _VoiceState;
    private bool                             _VoicePlayed;  // the clip was heard on _VoiceWindow (Replay instead of Play)
    private int                              _VoiceRequest; // request id in audio.js, 0 = none

    private VoicePillState VoicePillFor(GameplayWindow window)
    {
        // Rendered before OnAfterRender registered this window: show what UpdateVoiceOver is about to do
        if (!ReferenceEquals(window, _VoiceWindow)) return WillAutoplay(window, _SuppressScreenChange) ? VoicePillState.Starting : VoicePillState.Play;

        return _VoiceState switch
        {
            VoiceState.Starting => VoicePillState.Starting,
            VoiceState.Speaking => VoicePillState.Speaking,
            _                   => _VoicePlayed ? VoicePillState.Replay : VoicePillState.Play
        };
    }

    private bool WillAutoplay(GameplayWindow window, bool suppressed) =>
        !suppressed && Audio.Narration != NarrationVoice.Off && Audio.IsUnlocked && !(OliverClips(window) != null && Narration.IsPrivate(GlobalData, window));

    private bool HasNarration(GameplayWindow window) => window.VoiceOver != null || OliverClips(window) != null;

    private GameplayWindow? _OliverWindow; // the window _OliverClips was computed for
    private List<string>?   _OliverClips;

    // Oliver clips of the window when the Oliver voice is chosen, else null (then the original recording, if any, plays)
    private List<string>? OliverClips(GameplayWindow window)
    {
        if (Audio.Narration != NarrationVoice.Oliver) return null;
        if (!ReferenceEquals(window, _OliverWindow))
        {
            _OliverWindow = window;
            _OliverClips  = Narration.Clips(GlobalData, window);
        }

        return _OliverClips;
    }

    private void UpdateVoiceOver(ScreenChangeInfo info)
    {
        // info.Presented is null while a mirror question is open
        if (_VoiceState != VoiceState.Idle && !ReferenceEquals(info.Presented, _VoiceWindow)) StopVoice();

        if (info.Presented is not GameplayWindow window || !HasNarration(window) || ReferenceEquals(window, _VoiceWindow)) return;

        _VoiceWindow = window;
        _VoicePlayed = false;
        _VoiceState  = VoiceState.Idle;
        if (info.Change != ScreenChange.None && WillAutoplay(window, info.Suppressed)) StartVoice(true);
        StateHasChanged();
    }

    private void StartVoice(bool leadIn)
    {
        if (_VoiceWindow == null) return;

        if (OliverClips(_VoiceWindow) is { } clips)
        {
            _VoiceRequest = Audio.VoicePlayList(clips);
        }
        else
        {
            if (_VoiceWindow.VoiceOver == null) return;

            // Off has no chosen voice: its Play button uses the female voice. Oliver falls back to the male recording.
            NarrationVoice voice = Audio.Narration is NarrationVoice.Male or NarrationVoice.Oliver ? NarrationVoice.Male : NarrationVoice.Female;
            _VoiceRequest = Audio.VoicePlay(_VoiceWindow.VoiceOver, voice, leadIn);
        }

        _VoiceState   = _VoiceRequest != 0 ? VoiceState.Starting : VoiceState.Idle;
    }

    private void StopVoice()
    {
        _VoiceRequest = 0;
        _VoiceState   = VoiceState.Idle;
        Audio.VoiceStop();
    }

    // From audio.js: "speaking" (the clip plays) or "stopped" (finished, stopped, blocked or failed)
    [JSInvokable]
    public void OnVoiceState(int request, string state)
    {
        if (request == 0 || request != _VoiceRequest) return; // an earlier request

        if (state == "speaking")
        {
            _VoiceState  = VoiceState.Speaking;
            _VoicePlayed = true;
        }
        else
        {
            _VoiceState   = VoiceState.Idle;
            _VoiceRequest = 0;
        }

        StateHasChanged();
    }

    // Play / Replay: the clip without the lead-in
    private void OnPlayVoiceClicked()
    {
        Audio.PlayClick();
        StartVoice(false);
    }

    private void OnStopVoiceClicked()
    {
        Audio.PlayClick();
        StopVoice();
    }

    public void Dispose()
    {
        _ = Js.InvokeVoidAsync("mfwAtmosphere.stop", "game-fx");
        Audio.NarrationChanged -= OnNarrationSettingChanged;
        Audio.VoiceUnsubscribe();
        StopVoice();
        _VoiceListener?.Dispose();
    }

    #endregion
    
    private async Task TriggerSavePopup()
    {
        _ShowPauseMenu     = false;
        _ShowSavePopup     = true;
        _Base64EncodedGame = await Js.InvokeAsync<string>("localStorage.getItem", "continue");
        StateHasChanged();
    }

    private void HideSavePopup()
    {
        _ShowSavePopup = false;
        _ShowPauseMenu = true;
        StateHasChanged();
    }

    private void GoBack()
    {
        Audio.PlayClick();
        _SuppressScreenChange = true;
        StopVoice();
        GlobalData.Undo();
        StateHasChanged();
    }

    private void GoForward()
    {
        Audio.PlayClick();
        _SuppressScreenChange = true;
        StopVoice();
        GlobalData.Redo();
        StateHasChanged();
    }

    private async void Pause()
    {
        Audio.PlayClick();
        string? saveState = await Js.InvokeAsync<string?>("localStorage.getItem", "continue");
        _IsThereAnySavedState = !string.IsNullOrEmpty(saveState);
        _ShowPauseMenu        = true;
        Audio.VoicePause(); // Unity: the pause button pauses the voice-over (SoundManager.OnVOPause)
        StateHasChanged();
    }

    private void Refresh()
    {
        StateHasChanged();
    }

    private async void SaveGameAsync()
    {
        GlobalData.SaveGame();

        _ShowSaveNotification = true;
        StateHasChanged();

        await Task.Delay(3000);
        _ShowSaveNotification = false;
        StateHasChanged();
    }

    #region Special events: banner, vote / bid countdown (Shared/RevealPanel.razor)

    private int  _BannerKey; // > 0 once a banner was shown; a new key restarts its animation
    private bool _ShowReveal;
    private bool _RevealBid;
    private Action<GlobalData>? _RevealCallback; // the "start the vote" link that opened the panel, followed on Accept

    private static readonly System.Text.RegularExpressions.Regex _StartRevealLink =
        new(@"\bstart the (vote|bid)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static bool IsRevealLink(GameplayElement element) => element.Callback != null && _StartRevealLink.IsMatch(element.Content);

    // Special event windows (SoundCue.SpecialEvent) are votes or bids: true = bid, false = vote, null = neither
    private static bool? RevealKind(GameplayWindow window)
    {
        if (window.Cue != SoundCue.SpecialEvent) return null;
        string text = string.Concat(window.Elements.Select(element => element.Content));
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"\bbid(s|ding)?\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase)) return true;
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"\bvot(e|es|ed|ing)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase)) return false;
        return null;
    }

    private void OnWindowLinkClicked(GameplayElement element)
    {
        if (IsRevealLink(element) && GlobalData.ActiveWindow != null)
        {
            OpenReveal(_StartRevealLink.Match(element.Content).Groups[1].Value.Equals("bid", StringComparison.OrdinalIgnoreCase), element.Callback);
            return;
        }

        InvokeWindowCallback(element.Callback!);
    }

    private void OpenReveal(bool bid, Action<GlobalData>? callback)
    {
        Audio.PlayClick();
        Audio.Play(SoundCue.Setup);
        _RevealBid      = bid;
        _RevealCallback = callback;
        _ShowReveal     = true;
    }

    private void AcceptReveal()
    {
        _ShowReveal = false;
        Action<GlobalData>? callback = _RevealCallback;
        _RevealCallback = null;
        if (callback != null) InvokeWindowCallback(callback);
    }

    private void CancelReveal()
    {
        _ShowReveal     = false;
        _RevealCallback = null;
    }

    private void ShowSpecialEventBanner(ScreenChangeInfo info)
    {
        if (info.Suppressed || info.Change == ScreenChange.None || info.Presented is not GameplayWindow { Cue: SoundCue.SpecialEvent }) return;
        _BannerKey++;
        StateHasChanged();
    }

    #endregion

    private void InvokeWindowCallback(Action<GlobalData> nextCallback)
    {
        Audio.PlayClick();
        bool fromHub = GlobalData.ActiveWindow == null;
        GlobalData.RunScenarioAction(() =>
        {
            if (fromHub) GlobalData.SecretPagesShown = false; // the players act on the hub: the notice has done its job
            GlobalData.ActiveWindow = null;
            nextCallback.Invoke(GlobalData);
        });
    }
}