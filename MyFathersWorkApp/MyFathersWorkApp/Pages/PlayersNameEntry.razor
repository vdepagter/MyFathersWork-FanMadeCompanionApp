@page "/PlayersNameEntry/{PlayerIndex:int}"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio
@inject GalleryService    Gallery

<MenuPage OnBack="GoBack" Class="centered">
    <div class="pass-book">
        @GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_Title).FormatWithIndex(0, PlayerIndex).AsMarkup()
    </div>

    <p class="mp-lead">
        @GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_SubTitle).FormatWithIndex(0, PlayerIndex).AsMarkup()
    </p>

    @if (_LastTable.Count > 0)
    {
        // Endings Gallery: the players of the last game, in seat order
        <div class="same-table mfw-dark-panel">
            <div>@GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_SameTable)</div>
            <div class="same-table-names">@string.Join(", ", _LastTable)</div>
            <button class="mp-chip" @onclick="UseLastTable">@GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_UseTable)</button>
        </div>
    }

    <input class="mp-input" @bind="_PlayerName" @bind:event="oninput"
           @onkeydown="@(e => { if (e.Key is "Enter" or "NumpadEnter") Continue(); })"
           placeholder="@GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_Placeholder)"/>

    @if (_Remembered.Count > 0)
    {
        <div class="remembered">
            <div class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.PlayersNameEntry_Remembered)</div>
            <div class="remembered-names">
                @foreach (string name in _Remembered)
                {
                    <button class="mp-chip @(name == _PlayerName ? "selected" : "")" @onclick="() => PickName(name)">@name</button>
                }
            </div>
        </div>
    }

    <button class="mfw-button mp-button" @onclick="Continue">
        @GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Continue)
    </button>
</MenuPage>

@if (_ShowPopup || _ShowPopUp2)
{
    <div class="mp-popup-overlay" @onclick="ClosePopup">
        <div class="mp-popup mfw-parchment mfw-ink mfw-zoom-in">
            <p>@GlobalData.GetLocalizedUITag(_ShowPopup ? GlobalTags.PlayersNameEntry_PopUp : GlobalTags.PlayersNameEntry_PopUp2)</p>
            <button class="mfw-button mp-button" @onclick="ClosePopup">OK</button>
        </div>
    </div>
}

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;
    
    [Parameter] public int PlayerIndex { get; set; }

    private string _PlayerName = string.Empty;

    private List<string> _Remembered = [];
    private List<string> _LastTable  = [];

    protected override async Task OnParametersSetAsync()
    {
        GalleryData data = await Gallery.GetAsync();

        // Names already taken by earlier players of this game are left out
        _Remembered = (await Gallery.PlayerNamesAsync())
                      .Where(name => !Enumerable.Range(0, PlayerIndex).Any(x => string.Equals(GlobalData.GetPlayerNameByIndex(x), name, StringComparison.CurrentCultureIgnoreCase)))
                      .ToList();
        _LastTable = PlayerIndex == 0 && data.LastTable.Count == GlobalData.PlayersNum ? data.LastTable : [];
    }

    private void PickName(string name)
    {
        Audio.PlayClick();
        _PlayerName = name;
    }

    private void UseLastTable()
    {
        Audio.PlayClick();
        GlobalData.PlayerAName = _LastTable[0];
        GlobalData.PlayerBName = _LastTable[1];
        GlobalData.PlayerCName = _LastTable.Count >= 3 ? _LastTable[2] : string.Empty;
        GlobalData.PlayerDName = _LastTable.Count >= 4 ? _LastTable[3] : string.Empty;
        Nav.NavigateTo("PlayersVillage");
    }
    private bool   _ShowPopup;
    private bool   _ShowPopUp2;

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo(PlayerIndex == 0 ? "PlayersInitial" : $"PlayersWelcome/{PlayerIndex - 1}");
    }

    private void Continue()
    {
        Audio.PlayClick();
        if (_PlayerName.Length < 2 || _PlayerName.Length > 15)
        {
            _ShowPopup = true;
            return;
        }

        for (int x = 0; x < PlayerIndex; ++x)
        {
            if (!string.Equals(GlobalData.GetPlayerNameByIndex(x), _PlayerName, StringComparison.CurrentCultureIgnoreCase)) continue;
            _ShowPopUp2 = true;
            return;
        }

        switch (PlayerIndex)
        {
            case 0:
            {
                GlobalData.PlayerAName = _PlayerName;
                break;
            }
            case 1:
            {
                GlobalData.PlayerBName = _PlayerName;
                break;
            }
            case 2:
            {
                GlobalData.PlayerCName = _PlayerName;
                break;
            }
            case 3:
            {
                GlobalData.PlayerDName = _PlayerName;
                break;
            }
            default:
            {
                Nav.NavigateTo("");
                break;
            }
        }
        
        Nav.NavigateTo($"PlayersWelcome/{PlayerIndex}");
    }
    
    private void ClosePopup()
    {
        _ShowPopup  = false;
        _ShowPopUp2 = false;
    }
}
