@page "/PlayersScenario"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio

<MenuPage Title="@GlobalData.GetLocalizedUITag(GlobalTags.Scenario_Title)" OnBack="GoBack">
    <p class="mp-lead">@GlobalData.GetLocalizedUITag(GlobalTags.Scenario_Subtitle).FormatWithReplacement(0, GlobalData.PlayersNum.ToString())</p>

    <div class="scenario-options">
        @foreach ((int id, string title, string desc) in _Scenarios)
        {
            <button class="scenario-card" @onclick="() => SelectScenario(id)">
                <span class="scenario-art" style="background-image: url(images/ui/scenario-@(id).webp)"></span>
                <span class="scenario-text">
                    <span class="scenario-title">@GlobalData.GetLocalizedUITag(title)</span>
                    <span class="scenario-desc">@GlobalData.GetLocalizedUITag(desc).AsMarkup()</span>
                </span>
            </button>
        }
    </div>
</MenuPage>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    // ScenarioId, name tag, description tag; the art is the Unity Scenario card (images/ui/scenario-<id>.webp)
    private static readonly (int Id, string Title, string Desc)[] _Scenarios =
    [
        (1, GlobalTags.Scenario_TheCostOfDisease, GlobalTags.Scenario_TheCostOfDisease_Desc),
        (2, GlobalTags.Scenario_FearOfTheUnknown, GlobalTags.Scenario_FearOfTheUnknown_Desc),
        (3, GlobalTags.Scenario_ATimeOfWar,       GlobalTags.Scenario_ATimeOfWar_Desc)
    ];

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("PlayersVillageConfirm");
    }

    private void SelectScenario(int id)
    {
        Audio.PlayClick();
        GlobalData.ScenarioId = (ScenarioId)id;

        Nav.NavigateTo("PlayersScenarioLanguage");
    }
}
