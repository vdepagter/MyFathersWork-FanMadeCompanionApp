@page "/SavedGames"
@using MyFathersWorkApp.Shared
@using System.Globalization
@inject NavigationManager Nav
@inject IJSRuntime        Js
@inject HttpClient        Http
@inject AudioService      Audio
@inject SavedGamesService Saves

<MenuPage Title="@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_SavedGames)" OnBack="GoBack">
    <p class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Note)</p>

    @if (_Loaded)
    {
        @if (_Current != null)
        {
            <h2 class="mp-section-title">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Current)</h2>
            <div class="save-card mfw-dark-panel">
                @Describe(_Current)
                <div class="save-buttons">
                    <button class="mfw-button mp-button save-main" @onclick="ContinueCurrent">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Continue)</button>
                </div>
            </div>
        }

        <h2 class="mp-section-title">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Earlier)</h2>

        @if (_Games.Count == 0)
        {
            <p class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_None)</p>
        }

        @foreach (SavedGameInfo game in _Games.OrderByDescending(game => game.LastPlayed))
        {
            <div class="save-card mfw-dark-panel">
                @Describe(game)
                <div class="save-buttons">
                    <button class="mfw-button mp-button save-main" @onclick="() => Open(game.Id)">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Open)</button>
                    <button class="mp-chip" @onclick="() => DownloadSaveCode(game)">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_SaveCode)</button>
                    @if (_ConfirmDelete == game.Id)
                    {
                        <button class="mp-chip danger" @onclick="() => Delete(game.Id)">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_SureDelete)</button>
                    }
                    else
                    {
                        <button class="mp-chip" @onclick="() => AskDelete(game.Id)">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Delete)</button>
                    }
                </div>
            </div>
        }

        @if (_Message != string.Empty)
        {
            <p class="mp-note">@_Message</p>
        }

        @* Load a save code (a file or pasted text); this was Load Game on the Main Menu *@
        <h2 class="mp-section-title">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Import)</h2>
        <div class="save-card mfw-dark-panel import">
            <p class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_ImportNote)</p>
            <textarea class="mp-input" @bind="_ImportCode" @bind:event="oninput"
                      placeholder="@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_PasteSaveDataHere)"></textarea>
            <div class="save-buttons">
                <label class="mp-chip">
                    @GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_ImportFile)
                    <InputFile class="import-file" accept=".txt,text/plain" OnChange="LoadImportFile"/>
                </label>
                <button class="mfw-button mp-button save-main" disabled="@string.IsNullOrWhiteSpace(_ImportCode)" @onclick="ImportCode">
                    @GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_LoadGame)
                </button>
            </div>
            @if (_ImportFailed)
            {
                <p class="mp-note import-failed">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_ImportFailed)</p>
            }
        </div>
    }
</MenuPage>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private bool                _Loaded;
    private SavedGameInfo?      _Current;
    private List<SavedGameInfo> _Games         = [];
    private string              _ConfirmDelete = string.Empty;
    private string              _Message       = string.Empty;
    private string              _ImportCode    = string.Empty;
    private bool                _ImportFailed;

    protected override async Task OnInitializedAsync()
    {
        _Current = await Saves.CurrentAsync();
        _Games   = await Saves.ListAsync();
        _Loaded  = true;
    }

    private RenderFragment Describe(SavedGameInfo game) => @<div class="save-text">
        <div class="save-title">@GalleryTrees.Name(game.Scenario)@(game.Town != string.Empty ? $" · {game.Town}" : "")</div>
        <div class="save-sub">@string.Join(", ", game.Players)</div>
        <div class="save-sub">
            @(game.Ending != string.Empty
                ? GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Ended).FormatWithReplacement(0, game.Ending)
                : GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_Round).FormatWithIndex(0, (int)game.Years).FormatWithIndex(1, (int)game.Generation))
            · @FormatDate(game.LastPlayed)
        </div>
        @if (!game.History)
        {
            <div class="save-sub">@GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_NoHistory)</div>
        }
    </div>;

    private static string FormatDate(DateTime utc) => utc.ToLocalTime().ToString("d MMM yyyy, HH:mm", CultureInfo.InvariantCulture);

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }

    private async Task ContinueCurrent()
    {
        Audio.PlayClick();
        await GlobalData.LoadGameAsync(string.Empty, Nav, Http, Js);
        Nav.NavigateTo("Gameplay");
    }

    private async Task Open(string id)
    {
        Audio.PlayClick();
        _ConfirmDelete = string.Empty;

        if (!await Saves.OpenAsync(id))
        {
            _Message = GlobalData.GetLocalizedUITag(GlobalTags.SavedGames_OpenFailed);
            _Current = await Saves.CurrentAsync();
            _Games   = await Saves.ListAsync();
            return;
        }

        await GlobalData.LoadGameAsync(string.Empty, Nav, Http, Js);
        Nav.NavigateTo("Gameplay");
    }

    private async Task DownloadSaveCode(SavedGameInfo game)
    {
        Audio.PlayClick();
        string code = await Saves.SaveCodeAsync(game.Id);
        if (code == string.Empty) return;
        string name = $"MyFathersWork_{game.Scenario}_{game.LastPlayed.ToLocalTime():yyyy-MM-dd_HHmm}.txt";
        await Js.InvokeVoidAsync("BlazorDownloadFile", name, "text/plain;charset=utf-8", code);
    }

    private async Task LoadImportFile(InputFileChangeEventArgs e)
    {
        using StreamReader reader = new(e.File.OpenReadStream());
        _ImportCode   = (await reader.ReadToEndAsync()).Trim();
        _ImportFailed = false;
    }

    private async Task ImportCode()
    {
        Audio.PlayClick();
        string code = _ImportCode.Trim();
        if (code == string.Empty) return;

        if (!Convert.TryFromBase64String(code, new byte[code.Length], out int _))
        {
            _ImportFailed = true;
            return;
        }

        await Saves.ArchiveCurrentAsync(); // the loaded game replaces the one being played, which stays in the list
        await GlobalData.LoadGameAsync(code, Nav, Http, Js);
        Nav.NavigateTo("Gameplay");
    }

    private void AskDelete(string id)
    {
        Audio.PlayClick();
        _ConfirmDelete = id;
    }

    private async Task Delete(string id)
    {
        Audio.PlayClick();
        _ConfirmDelete = string.Empty;
        await Saves.DeleteAsync(id);
        _Games = await Saves.ListAsync();
    }
}
