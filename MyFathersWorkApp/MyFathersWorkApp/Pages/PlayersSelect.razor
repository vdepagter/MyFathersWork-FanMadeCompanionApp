@page "/PlayersSelect"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio

<MenuPage Title="@GlobalData.GetLocalizedUITag(GlobalTags.PlayersSelect_Title)" OnBack="GoBack" Class="centered">
    <p class="mp-lead">@GlobalData.GetLocalizedUITag(GlobalTags.PlayersSelect_SubTitle)</p>

    <div class="player-options">
        @foreach (int count in new[] { 2, 3, 4 })
        {
            <button class="player-option" @onclick="() => SelectPlayers(count)">
                <img src="images/ui/players-@(count).webp" alt=""/>
                <span>@GlobalData.GetLocalizedUITag(count switch { 2 => GlobalTags.PlayersSelect_Two, 3 => GlobalTags.PlayersSelect_Three, _ => GlobalTags.PlayersSelect_Four })</span>
            </button>
        }
    </div>
</MenuPage>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private void SelectPlayers(int playerCount)
    {
        Audio.PlayClick();
        GlobalData.PlayersNum = playerCount;
        Nav.NavigateTo("PlayersInitial");
    }

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }
}