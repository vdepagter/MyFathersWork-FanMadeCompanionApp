@page "/PlayersVillageConfirm"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio

<MenuPage OnBack="GoBack" Class="centered">
    <div class="mp-parchment mfw-zoom-in">
        @GlobalData.GetLocalizedUITag(GlobalTags.VillageConfirm_Content).FormatWithReplacement(0, GlobalData.TownName).ProtectNames(GlobalData).AsMarkup()
    </div>

    <button class="mfw-button mp-button" @onclick="Continue">
        @GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Continue)
    </button>
</MenuPage>

@code 
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("PlayersVillage");
    }

    private void Continue()
    {
        Audio.PlayClick();
        Nav.NavigateTo("PlayersScenario");
    }
}