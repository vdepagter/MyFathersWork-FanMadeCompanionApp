@page "/PlayersWelcome/{PlayerIndex:int}"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio

<MenuPage OnBack="GoBack" Class="centered">
    <div class="welcome-paper mfw-zoom-in">
        <p>
            @GetWelcomeText().ProtectNames(GlobalData).AsMarkup()
        </p>
    </div>

    <button class="mfw-button mp-button" @onclick="Continue">
        @GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Continue)
    </button>
</MenuPage>

@code 
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;
    
    [Parameter]
    public int PlayerIndex { get; set; }

    private string GetWelcomeText()
    {
        string rawText = PlayerIndex switch
        {
            0     => GlobalData.GetLocalizedUITag(GlobalTags.PlayersWelcome_First),
            1     => GlobalData.GetLocalizedUITag(GlobalTags.PlayersWelcome_Second),
            2     => GlobalData.GetLocalizedUITag(GlobalTags.PlayersWelcome_Third),
            3     => GlobalData.GetLocalizedUITag(GlobalTags.PlayersWelcome_Fourth),
                _ => string.Empty
        };

        string name = GlobalData.GetPlayerNameByIndex(PlayerIndex);

        if (rawText == string.Empty || name == string.Empty) Nav.NavigateTo("");

        return rawText.FormatWithReplacement(0, name);
    }
    
    private void Continue()
    {
        Audio.PlayClick();
        Nav.NavigateTo(PlayerIndex == GlobalData.PlayersNum - 1 ? "PlayersVillage" : $"PlayersNameEntry/{PlayerIndex + 1}");
    }
    
    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo($"PlayersNameEntry/{PlayerIndex}");
    }
}