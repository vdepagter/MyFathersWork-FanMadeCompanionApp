@page "/EndingsGallery"
@using System.Globalization
@inject NavigationManager Nav
@inject IJSRuntime        Js
@inject AudioService      Audio
@inject GalleryService    Gallery

<div class="back-button" @onclick="GoBack">
    ⬅ @GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Back)
</div>

<div class="gallery-container">
    <h1>@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Gallery)</h1>

    <div class="gallery-tabs" role="tablist">
        <button role="tab" aria-selected="@(!_EndingsTab)" class="@(!_EndingsTab ? "selected" : "")" @onclick="() => SelectTab(false)">
            @GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Players)
        </button>
        <button role="tab" aria-selected="@_EndingsTab" class="@(_EndingsTab ? "selected" : "")" @onclick="() => SelectTab(true)">
            @GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Endings)
        </button>
    </div>

    @if (_Data == null)
    {
    }
    else if (!_EndingsTab)
    {
        <div class="tally-row tally-head">
            <span>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Player)</span>
            <span title="@GalleryTrees.Name(ScenarioId.CostOfDisease)">CoD</span>
            <span title="@GalleryTrees.Name(ScenarioId.FearOfUnknown)">FotU</span>
            <span title="@GalleryTrees.Name(ScenarioId.TimeOfWar)">AToW</span>
            <span class="tally-wins">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Wins)</span>
            <span></span>
        </div>

        @foreach (TallyLine line in Tally())
        {
            <div class="tally-row tally-card @(line.Family ? "family" : "")">
                <div class="tally-name">
                    <span>@line.Name</span>
                    <span class="tally-sub">@line.Sub</span>
                </div>
                @foreach (int wins in line.PerScenario)
                {
                    <span class="tally-cell">@wins</span>
                }
                <span class="tally-wins">@line.Wins</span>
                @if (line.Forgettable)
                {
                    string label = GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Forget).FormatWithReplacement(0, line.Name);
                    <button class="tally-forget" aria-label="@label" title="@label" @onclick="() => Forget(line.Name)">×</button>
                }
                else
                {
                    <span></span>
                }
            </div>
        }

        <h2>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_RecentGames)</h2>

        @if (_Data.Games.Count == 0)
        {
            <p class="gallery-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_NoGames)</p>
        }

        @foreach (GalleryGame game in _Data.Games.OrderByDescending(game => game.Date).Take(10))
        {
            <div class="recent-game">
                <div>
                    <div>@game.Title</div>
                    <div class="tally-sub">@GalleryTrees.Name(game.Scenario) · @FormatDate(game.Date) · @string.Join(", ", game.Players)</div>
                </div>
                <span class="recent-winner">@(game.FamilyWinner ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Family) : game.Winner)</span>
            </div>
        }

        <h2>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Backup)</h2>
        <p class="gallery-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_BackupNote)</p>

        <div class="gallery-buttons">
            <button class="gallery-button" @onclick="Export">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Export)</button>
            <button class="gallery-button" @onclick="ShowImport">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Import)</button>
        </div>

        @if (_Export != string.Empty)
        {
            <textarea class="gallery-box" readonly>@_Export</textarea>
            <div class="gallery-buttons">
                <button class="gallery-button" @onclick="CopyExport">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Copy)</button>
                <button class="gallery-button" @onclick="DownloadExport">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_DownloadFile)</button>
            </div>
        }

        @if (_ShowImport)
        {
            <textarea class="gallery-box" @bind="_ImportText" placeholder="@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_PasteHere)"></textarea>
            <div class="gallery-buttons">
                <InputFile OnChange="@LoadImportFile"/>
                <button class="gallery-button" @onclick="Import">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Import)</button>
            </div>
        }

        @if (_ImportMessage != string.Empty)
        {
            <p class="gallery-note">@_ImportMessage</p>
        }
    }
    else
    {
        <div class="scenario-tabs">
            @foreach (ScenarioId scenario in GalleryTrees.Scenarios)
            {
                <button class="@(scenario == _Scenario ? "selected" : "")" aria-pressed="@(scenario == _Scenario)" @onclick="() => SelectScenario(scenario)">
                    <span>@GalleryTrees.Name(scenario)</span>
                    <span class="scenario-count">@GalleryService.EndingsDone(_Data, scenario).Count / 8</span>
                </button>
            }
        </div>

        <div class="tree-toolbar">
            <span>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_EndingsCount).FormatWithReplacement(0, GalleryService.EndingsDone(_Data, _Scenario).Count.ToString())</span>
            <button class="gallery-button" @onclick="ToggleShowAll">
                @GlobalData.GetLocalizedUITag(_ShowAll ? GlobalTags.Gallery_HideSpoilers : GlobalTags.Gallery_ShowAll)
            </button>
        </div>

        <div class="tree">
            @foreach (TreeRow row in TreeRows())
            {
                <div class="tree-row">
                    <div style="width: @(row.Node.Depth * 18)px; flex-shrink: 0;"></div>
                    <div class="tree-rail">
                        <div class="tree-line @(row.Node.Depth == 0 ? "hidden" : "")"></div>
                        <div class="tree-node @(row.Node.IsEnding ? "ending" : "") @(row.Lit ? "lit" : "")"></div>
                        <div class="tree-line grow @(row.HasChild ? "" : "hidden")"></div>
                    </div>
                    <div class="tree-text">
                        <span class="tree-kicker">@row.Kicker</span>
                        <span class="tree-label @(row.Lit ? "lit" : row.Known ? "" : "locked")">@row.Label</span>
                        @if (row.Status != string.Empty)
                        {
                            <span class="tree-status @(row.Played || row.Ticked ? "done" : "")">@row.Status</span>
                        }
                    </div>
                    <div class="tree-action">
                        @if (!row.Known)
                        {
                            <button class="gallery-button small" @onclick="() => Reveal(row.Key)">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Reveal)</button>
                        }
                        else if (row.Node.IsEnding && row.Played)
                        {
                            <span class="tree-star" role="img" aria-label="@row.Status">★</span>
                        }
                        else if (row.Node.IsEnding)
                        {
                            string label = GlobalData.GetLocalizedUITag(row.Ticked ? GlobalTags.Gallery_Untick : GlobalTags.Gallery_TickOff).FormatWithReplacement(0, row.Label);
                            <button class="tree-tick @(row.Ticked ? "ticked" : "")" aria-pressed="@row.Ticked" aria-label="@label" title="@label"
                                    @onclick="() => ToggleTick(row.Node.Ending, !row.Ticked)">@(row.Ticked ? "✓" : "")</button>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="gallery-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Legend)</p>
    }
</div>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private record TallyLine(string Name, string Sub, int[] PerScenario, int Wins, bool Family, bool Forgettable);

    private record TreeRow(GalleryNode Node, string Key, string Kicker, string Label, string Status, bool Known, bool Lit, bool Played, bool Ticked, bool HasChild);

    private GalleryData? _Data;
    private bool         _EndingsTab;
    private ScenarioId   _Scenario = ScenarioId.CostOfDisease;
    private bool         _ShowAll;
    private string       _Export        = string.Empty;
    private bool         _ShowImport;
    private string       _ImportText    = string.Empty;
    private string       _ImportMessage = string.Empty;

    private readonly HashSet<string> _Revealed = [];

    protected override async Task OnInitializedAsync()
    {
        _Data = await Gallery.GetAsync();

        // Open the endings of the scenario played last
        GalleryGame? last = _Data.Games.OrderByDescending(game => game.Date).FirstOrDefault();
        if (last != null) _Scenario = last.Scenario;
    }

    private static string FormatDate(DateTime date) => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private IEnumerable<TallyLine> Tally()
    {
        GalleryData    data  = _Data!;
        HashSet<string> names = data.Players.Select(player => player.Name).ToHashSet();
        names.UnionWith(data.Games.SelectMany(game => game.Players));

        int[] PerScenario(Func<GalleryGame, bool> won) => GalleryTrees.Scenarios.Select(scenario => data.Games.Count(game => game.Scenario == scenario && won(game))).ToArray();

        List<TallyLine> lines = names.Select(name =>
                                     {
                                         int[] perScenario = PerScenario(game => !game.FamilyWinner && game.Winner == name);
                                         int   played      = data.Games.Count(game => game.Players.Contains(name));
                                         return new TallyLine(name,
                                                              GlobalData.GetLocalizedUITag(GlobalTags.Gallery_GamesPlayed).FormatWithReplacement(0, played.ToString()),
                                                              perScenario, perScenario.Sum(), false, data.Players.Any(player => player.Name == name));
                                     })
                                     .OrderByDescending(line => line.Wins)
                                     .ThenBy(line => line.Name, StringComparer.CurrentCultureIgnoreCase)
                                     .ToList();

        int[] family = PerScenario(game => game.FamilyWinner);
        if (family.Sum() > 0)
        {
            lines.Add(new TallyLine(GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Family), GlobalData.GetLocalizedUITag(GlobalTags.Gallery_FamilyNote),
                                    family, family.Sum(), true, false));
        }

        return lines;
    }

    private IEnumerable<TreeRow> TreeRows()
    {
        GalleryData   data    = _Data!;
        GalleryNode[] tree    = GalleryTrees.Tree(_Scenario);
        HashSet<int>  done    = GalleryService.EndingsDone(data, _Scenario);
        List<int>     reached = GalleryService.Entry(data.Reached, _Scenario);
        List<int>     ticked  = GalleryService.Entry(data.Ticked, _Scenario);

        for (int i = 0; i < tree.Length; i++)
        {
            GalleryNode node = tree[i];
            string      key  = $"{_Scenario}:{i}";
            bool        lit;

            if (node.IsEnding) lit = done.Contains(node.Ending);
            else
            {
                // A branch is lit when it was reached in play or an ending below it is done
                lit = reached.Contains(node.HubId);
                for (int j = i + 1; !lit && j < tree.Length && tree[j].Depth > node.Depth; j++) lit = tree[j].IsEnding && done.Contains(tree[j].Ending);
            }

            bool         known      = lit || _ShowAll || _Revealed.Contains(key);
            GalleryGame? lastPlayed = node.IsEnding ? data.Games.Where(game => game.Scenario == _Scenario && game.Ending == node.Ending).MaxBy(game => game.Date) : null;
            bool         isTicked   = node.IsEnding && ticked.Contains(node.Ending);

            string label = !known       ? GlobalData.GetLocalizedUITag(node.IsEnding ? GlobalTags.Gallery_LockedEnding : GlobalTags.Gallery_LockedBranch)
                         : lastPlayed != null && lastPlayed.Title != string.Empty ? lastPlayed.Title
                         : node.Label;

            string status = string.Empty;
            if (node.IsEnding && known)
            {
                status = lastPlayed != null ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Played).FormatWithReplacement(0, FormatDate(lastPlayed.Date))
                       : isTicked           ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_TickedByHand)
                       : GlobalData.GetLocalizedUITag(GlobalTags.Gallery_NotReached);
                if (node.AlsoElsewhere) status += " · " + GlobalData.GetLocalizedUITag(GlobalTags.Gallery_AlsoElsewhere);
            }
            else if (lit) status = GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Reached);

            string kicker = node.IsEnding
                                ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Ending)
                                : GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Generation).FormatWithIndex(0, node.Depth + 1);

            bool hasChild = i + 1 < tree.Length && tree[i + 1].Depth > node.Depth;
            yield return new TreeRow(node, key, kicker, label, status, known, lit, lastPlayed != null, isTicked, hasChild);
        }
    }

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }

    private void SelectTab(bool endings)
    {
        Audio.PlayClick();
        _EndingsTab = endings;
    }

    private void SelectScenario(ScenarioId scenario)
    {
        Audio.PlayClick();
        _Scenario = scenario;
    }

    private void ToggleShowAll()
    {
        Audio.PlayClick();
        _ShowAll = !_ShowAll;
    }

    private void Reveal(string key)
    {
        Audio.PlayClick();
        _Revealed.Add(key);
    }

    private async Task ToggleTick(int ending, bool ticked)
    {
        Audio.PlayClick();
        await Gallery.SetTickedAsync(_Scenario, ending, ticked);
    }

    private async Task Forget(string name)
    {
        Audio.PlayClick();
        await Gallery.ForgetPlayerAsync(name);
    }

    private async Task Export()
    {
        Audio.PlayClick();
        _ShowImport    = false;
        _ImportMessage = string.Empty;
        _Export        = await Gallery.ExportAsync();
    }

    private async Task CopyExport()
    {
        Audio.PlayClick();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _Export);
    }

    private async Task DownloadExport()
    {
        Audio.PlayClick();
        await Js.InvokeVoidAsync("BlazorDownloadFile", "MyFathersWorkEndingsGallery.txt", "text/plain;charset=utf-8", _Export);
    }

    private void ShowImport()
    {
        Audio.PlayClick();
        _Export        = string.Empty;
        _ImportMessage = string.Empty;
        _ShowImport    = true;
    }

    private async Task LoadImportFile(InputFileChangeEventArgs e)
    {
        using StreamReader reader = new StreamReader(e.File.OpenReadStream(1024 * 1024));
        _ImportText = (await reader.ReadToEndAsync()).Trim();
    }

    private async Task Import()
    {
        Audio.PlayClick();
        if (string.IsNullOrWhiteSpace(_ImportText)) return;

        bool ok = await Gallery.ImportAsync(_ImportText);
        _ImportMessage = GlobalData.GetLocalizedUITag(ok ? GlobalTags.Gallery_ImportDone : GlobalTags.Gallery_ImportFailed);
        if (!ok) return;

        _ShowImport = false;
        _ImportText = string.Empty;
    }
}
